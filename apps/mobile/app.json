{
  "name": "DecorBucket",
  "displayName": "DecorBucket",
  "expo": {
    "name": "DecorBucket",
    "slug": "decor-bucket",
    "runtimeVersion": "1",
    "ios": {
      "bundleIdentifier": "com.decorbucket"
    },
    "android": {
      "package": "com.decorbucket"
    },
    "updates": {
      "enabled": true,
      "url": "http://localhost:3001/api/updates/manifest",
      "checkAutomatically": "ON_LOAD",
      "requestHeaders": {
        "expo-channel-name": "development"
      },
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    }
  }
}
