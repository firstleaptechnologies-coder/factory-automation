# Identifiers, from the environment rather than committed.
#
# The bundle id is public and lives in the native project anyway. The team and
# the App Store Connect key are account-level facts that belong in repository
# secrets, so a fork of this public repository cannot act as FirstLeap.
app_identifier(ENV["IOS_BUNDLE_ID"] || "com.firstleap.factoryautomation")
apple_id(ENV["APPLE_ID"])
team_id(ENV["APPLE_TEAM_ID"])

package_name(ENV["ANDROID_PACKAGE"] || "com.firstleap.factoryautomation")
