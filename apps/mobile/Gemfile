source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
gem 'xcodeproj', '< 1.26.0'
gem 'concurrent-ruby', '< 1.3.4'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'

# The store build lanes — see fastlane/Fastfile. Both native workflows run
# `bundle exec fastlane`.
#
# Pinned to a minor range rather than locked. There is deliberately no
# Gemfile.lock: CI runs Ruby 3.3, and the only rubies on a developer machine
# here are macOS's 2.6 and Homebrew's 4.0 — a lock resolved under either
# constrains CI to versions chosen for a Ruby it is not running, which is worse
# than resolving fresh. The pin gives most of the reproducibility without that.
gem 'fastlane', '~> 2.230'
