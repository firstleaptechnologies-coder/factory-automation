{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // The specs read the filesystem (route names) and use jest globals.
    "types": ["node", "jest"],
    "paths": {
      "@decor/shared": ["../../packages/shared/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "*.tsx", "*.ts", "index.js"],
  "exclude": ["node_modules", "ios", "android"]
}
