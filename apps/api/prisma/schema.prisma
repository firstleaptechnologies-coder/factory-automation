// Decor Bucket — order punching.
//
// Two rules run through this whole schema:
//
//  1. Every physical dimension is stored in MILLIMETRES, as Decimal. Feet is a
//     presentation unit, converted at the edges. One canonical unit means a
//     size can never be ambiguous in the database.
//
//  2. Anything the admin can configure — statuses, the flow between them,
//     materials, thicknesses, size presets — lives in a table, not in an enum.
//     Orders keep a snapshot of what they were punched with, so editing a
//     preset later never rewrites history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // What the application connects with. In production this goes through a
  // connection pooler, because a pool per instance against Postgres directly
  // runs out of connections long before it runs out of instances.
  url       = env("DATABASE_URL")
  // What migrations connect with. A pooler in transaction mode cannot carry
  // the session state the migration engine needs — advisory locks and the
  // temporary objects a migration creates belong to a session the pooler is
  // free to hand to somebody else between statements. Locally the two are the
  // same string, and nothing is lost by saying so explicitly.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Platform (control plane)
// ---------------------------------------------------------------------------
//
// This product is sold to several manufacturing businesses. Everything below
// the platform layer belongs to exactly one tenant, and a tenant's data never
// crosses into another's.
//
// Two isolation models are offered as commercial tiers. A SHARED tenant lives
// in the platform database alongside others, separated by tenantId. A DEDICATED
// tenant gets its own database. The schema is identical in both, and every row
// carries tenantId even when it is alone in its database — that is what makes
// moving a tenant between tiers a data copy rather than a migration project.

enum TenantIsolation {
  /// Pooled in the platform database, separated by tenantId.
  SHARED
  /// Its own database, connection string held on the tenant record.
  DEDICATED
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Tenant {
  id   String @id @default(cuid())
  /// Typed at sign-in to reach this tenant, and used in URLs. Lowercase.
  slug String @unique
  name String

  isolation   TenantIsolation @default(SHARED)
  /// Only for DEDICATED. Encrypted at rest through EncryptionService.
  databaseUrl String?

  status  TenantStatus @default(TRIAL)
  /// Which bundle they are on. The catalogue lives in @fas/shared.
  plan    String?
  /// Modules granted on top of the plan.
  ///
  /// A shop that wants one thing from the next tier up should not have to buy
  /// the tier. Additive only: taking a module away from a shop that is using it
  /// is a conversation, not a checkbox.
  modules String[]     @default([])

  contactName  String?
  contactEmail String?
  contactPhone String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// The people who own the product. They belong to no tenant.
model PlatformUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// OWNER | SUPPORT | BILLING | ENGINEER — the list lives in @fas/shared.
  ///
  /// A fixed set rather than the composable roles a tenant gets: there are a
  /// few of us, not a few hundred, and the blast radius here is every
  /// workspace.
  role         String   @default("OWNER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A scheduled job's claim on being the one running it.
///
/// The API is one process today and will be several. Two of them waking at
/// 03:30 and both pruning, both pushing, both closing the day would each be a
/// bug that only shows up in production, so a job takes this lease before it
/// does anything. The lease expires on its own, which is what makes a crashed
/// holder recoverable without anyone clearing a flag by hand.
model JobLease {
  /// The job's dotted name — one lease per job, which is what the PK enforces.
  name       String   @id
  /// Which process holds it, for the "who is running this" question.
  holder     String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

/// One row per run of a scheduled job.
///
/// A cron that quietly stops running is invisible until someone notices the
/// thing it was supposed to do never happened. This is the record that answers
/// "did it run last night, and what did it do".
model JobRun {
  id         String    @id @default(cuid())
  /// Dotted name from the registry, e.g. "tenant.health".
  name       String
  /// RUNNING → OK | FAILED | SKIPPED. SKIPPED means another instance held the
  /// lease, which is a healthy outcome rather than a missed run.
  outcome    String    @default("RUNNING")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  /// What the run found, in the job's own words.
  detail     Json?
  error      String?

  @@index([name, startedAt])
  @@index([startedAt])
}

/// One row per call into the API that changed something, or failed.
///
/// Kept apart from the audit trail on purpose. The trail is a shop's own
/// business record and lives in their database; this is ours — how the product
/// is behaving, which calls are slow, what is failing and for whom. It spans
/// tenants because that is the only way to see a pattern, and it is written to
/// the platform database for the same reason: a dedicated tenant's database
/// would hide it.
///
/// Successful reads are not recorded. They are most of the traffic and say the
/// least, and a log nobody can afford to keep is a log nobody keeps.
model ServerLog {
  id         String   @id @default(cuid())
  /// Whose workspace it was. No FK: the row outlives the tenant.
  tenantId   String?
  tenantSlug String?
  /// Dotted name of what was called: `OrdersController.changeStatus`.
  action     String
  method     String
  path       String
  status     Int
  /// ok — it worked. refused — the caller was told no. failed — we broke.
  outcome    String
  durationMs Int
  userId     String?
  actorLabel String?
  /// Which client it came from, when it said: `web`, `app`.
  client     String?
  error      String?
  /// The same short code the caller was shown, so a phone call finds this row.
  reference  String?
  at         DateTime @default(now())

  @@index([at])
  @@index([outcome, at])
  @@index([action, at])
  @@index([tenantId, at])
  @@index([reference])
}

/// What the app and the browser saw.
///
/// A crash on the shop floor is otherwise something somebody has to describe
/// over the phone. The clients queue these and send them in batches, so a
/// device that is offline in a workshop still reports what happened once it is
/// back on the network.
model ClientLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  /// `app` or `web`.
  client     String
  /// `ios`, `android`, or the browser's own name.
  platform   String?
  appVersion String?
  /// info | warn | error
  level      String
  message    String
  /// Whatever the client thought was worth sending with it. Never a token.
  context    Json?
  /// When it happened on the device, which is not when it arrived.
  at         DateTime
  receivedAt DateTime @default(now())

  @@index([at])
  @@index([level, at])
  @@index([tenantId, at])
}

// ---------------------------------------------------------------------------
// Releases (the app binary and what it runs)
// ---------------------------------------------------------------------------
//
// The app in the stores is one product for every workspace, so all of this
// belongs to the platform rather than to a tenant. A shop's admin decides how
// their own shop works; only we decide what code the binary runs.
//
// The protocol is Expo Updates v1: the client asks for a manifest naming a JS
// bundle and its assets, verifies the signature, downloads what it does not
// have, and swaps it in on the next launch. Self-hosted, so a release does not
// wait on anybody else's service.

enum OtaPlatform {
  ios
  android
}

enum OtaReleaseKind {
  /// An ordinary update: here is a newer bundle.
  UPDATE
  /// Go back to the bundle the store binary shipped with. The way out when an
  /// update turns out to be worse than what it replaced.
  ROLLBACK
}

enum OtaReleaseStatus {
  /// Uploaded and inspectable, served to nobody.
  DRAFT
  /// Live, subject to the rollout percentage.
  PUBLISHED
  /// Retired. Kept, because what a shop was running last week is a question
  /// that gets asked after the fact.
  ARCHIVED
}

model OtaRelease {
  /// Used verbatim as the manifest id, so it has to be UUID-shaped.
  id             String           @id @default(uuid())
  /// Which stream this belongs to: `production` or `staging`.
  channel        String
  /// Must match the native build's own runtime version. A bundle built against
  /// different native code than the binary has is how an app crashes on launch
  /// with no way back except the store.
  runtimeVersion String
  platform       OtaPlatform
  kind           OtaReleaseKind   @default(UPDATE)
  status         OtaReleaseStatus @default(DRAFT)
  /// 0–100, sticky per install: a device that has seen an update keeps seeing
  /// it, so a staged rollout does not flip people back and forth.
  rolloutPercent Int              @default(0)
  /// The build number within (channel, platform, runtimeVersion), shown in the
  /// app as "OTA 7" so a person can say which one they are on.
  sequence       Int              @default(0)

  /// manifest.metadata and manifest.extra, as the client expects them.
  metadata    Json      @default("{}")
  extra       Json      @default("{}")
  /// For a rollback: the commit time the client compares against.
  commitTime  DateTime?
  changelog   String?
  /// The platform user who put it live.
  publishedBy String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  activatedAt DateTime?

  assets OtaReleaseAsset[]

  @@index([channel, runtimeVersion, platform, status, createdAt])
}

/// One file in a release: the JS bundle itself, or an image it needs.
///
/// Stored through the same StorageService as everything else — S3 where it is
/// configured, the database where it is not — so a release does not need a
/// second piece of infrastructure to exist.
model OtaReleaseAsset {
  id        String     @id @default(cuid())
  releaseId String
  release   OtaRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  /// True for the JS bundle. Exactly one per release.
  isLaunchAsset Boolean @default(false)

  /// hex MD5 of the bytes — the manifest's asset `key`.
  key           String
  /// base64url SHA-256 of the bytes — what the client checks the download
  /// against. Not the same hash as `key`, and they must not be conflated.
  hash          String
  contentType   String
  fileExtension String

  backend         StorageBackend
  bucket          String?
  objectKey       String?
  data            Bytes?
  byteSize        Int
  checksum        String
  isEncrypted     Boolean        @default(false)
  encryptionKeyId String?

  createdAt DateTime @default(now())

  @@unique([releaseId, key])
  @@index([releaseId])
}

/// The floor under which a binary is asked, or told, to update.
///
/// Some changes cannot be delivered over the air — a native module, a
/// permission, a new screen that needs one. This is how an old binary is told
/// so, rather than failing in ways nobody can explain over the phone.
model AppVersionGate {
  id       String      @id @default(cuid())
  platform OtaPlatform
  channel  String

  /// Below this, the app stops and says it must be updated.
  minimumVersion     String
  /// Below this, it says there is a newer one and carries on.
  recommendedVersion String?
  /// What the app shows. Left empty, it uses its own words.
  message            String?

  updatedAt DateTime @updatedAt

  @@unique([platform, channel])
}

/// A named set of permissions inside one tenant.
///
/// Roles are per-tenant rather than a fixed enum because every shop divides
/// work differently — one has a separate QC person, another has the owner doing
/// everything. Permissions are string keys checked by the guard; the canonical
/// list lives in @fas/shared.
model Role {
  id       String @id @default(cuid())
  tenantId String

  code        String
  name        String
  description String?
  permissions String[] @default([])
  /// Seeded roles a tenant admin may edit but not delete.
  isSystem    Boolean  @default(false)

  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// A GST rate a tenant can apply.
///
/// The slab is chosen on the order line, not on the material: the raw board is
/// an input, and what leaves the shop after cutting and finishing is a
/// different product that may be taxed differently. Tax is computed on the
/// amount actually quoted to the client.
model GstSlab {
  id       String @id @default(cuid())
  tenantId String

  name      String
  ratePct   Decimal @db.Decimal(5, 2)
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  orderItems    OrderItem[]
  estimateItems EstimateItem[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  SALES
  PRODUCTION
  VIEWER
}

model User {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId     String
  id           String   @id @default(cuid())
  code         String
  name         String
  email        String?
  phone        String?
  passwordHash String
  /// Kept as a coarse label for display and seeding. Authorisation comes from
  /// the role's permissions, not from this.
  role         UserRole @default(SALES)
  roleId       String?
  roleRef      Role?    @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ordersCreated     Order[]              @relation("OrderCreatedBy")
  statusChanges     OrderStatusHistory[]
  filesUploaded     StoredFile[]
  reportsRequested  Report[]             @relation("ReportRequestedBy")
  clientsCreated    Client[]             @relation("ClientCreatedBy")
  auditLogs         AuditLog[]
  leadsOwned        Lead[]               @relation("LeadOwner")
  leadsCreated      Lead[]               @relation("LeadCreatedBy")
  leadStatusChanges LeadStatusHistory[]  @relation("LeadStatusChangedBy")
  paymentsReceived  Payment[]            @relation("PaymentReceivedBy")
  cashDeposited     CashDeposit[]        @relation("CashDepositedBy")
  disbursements     Disbursement[]       @relation("DisbursementRecordedBy")
  estimates         Estimate[]           @relation("EstimateCreatedBy")
  notifications     Notification[]       @relation("NotificationFor")
  ledgerEntries     LedgerEntry[]
  expenses          Expense[]            @relation("ExpenseCreatedBy")
  expenseEdits      ExpenseEditHistory[] @relation("ExpenseEditBy")
  employee          Employee?            @relation("EmployeeLogin")
  employeesCreated  Employee[]           @relation("EmployeeCreatedBy")
  attendanceMarked  Attendance[]         @relation("AttendanceMarkedBy")
  vendorsCreated    Vendor[]             @relation("VendorCreatedBy")
  stockMovesMade    StockMove[]          @relation("StockMoveBy")

  @@unique([tenantId, code])
  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([role, isActive])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

/// Searchable while punching; new ones can be created inline from the same
/// screen, which is why only `name` is required.
model Client {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId  String
  id        String  @id @default(cuid())
  code      String
  name      String
  phone     String?
  /// A second number for the same firm — the site contact, or whoever actually
  /// answers. Optional; a client punched on the floor often has just the one.
  altPhone  String?
  email     String?
  gstin     String?
  /// The trading name on their paperwork, which is rarely the person's name.
  company   String?
  /// Their state, as the GST code and name ("08-Rajasthan"). It decides whether
  /// a supply is intra-state (CGST + SGST) or inter-state (IGST), so an invoice
  /// cannot be made correctly without it.
  stateCode String?
  stateName String?

  /// Kept as one free-text block each rather than split into lines: addresses
  /// here are pasted from WhatsApp far more often than typed field by field.
  address         String?
  billingAddress  String?
  shippingAddress String?
  notes           String?

  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("ClientCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders        Order[]
  locations     ClientLocation[]
  ledgerEntries LedgerEntry[]
  leads         Lead[]
  estimates     Estimate[]

  @@unique([tenantId, code])
  @@index([name])
  @@index([isActive])
  @@index([tenantId])
}

/// Sites a client orders for. Populated as they are typed during punching, so
/// the second order to the same site can pick it from a list.
model ClientLocation {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId  String
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  useCount  Int      @default(0)
  createdAt DateTime @default(now())

  orders Order[]

  @@unique([clientId, name])
  @@index([clientId, useCount])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Configurable masters
// ---------------------------------------------------------------------------

model Material {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId    String
  id          String   @id @default(cuid())
  code        String
  name        String
  description String?
  /// Hex, shown as a chip in lists and on the flow canvas.
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  thicknesses   MaterialThickness[]
  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]
  stockMoves    StockMove[]

  /// Order again when the rack falls below this many, in the unit below.
  /// Null means nobody is watching this material.
  reorderLevel Decimal? @db.Decimal(14, 3)
  /// What one of them is: a sheet, a kilo, a length. The shop's own word.
  stockUnit    String   @default("sheet")

  @@unique([tenantId, code])
  @@index([isActive, sortOrder])
  @@index([tenantId])
}

/// The thickness options offered for a material. Stored in mm; the admin may
/// type them in any unit and the UI converts before saving.
model MaterialThickness {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId   String
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  valueMm    Decimal  @db.Decimal(12, 3)
  /// Optional display override, e.g. "3/4 inch" for 19.05 mm.
  label      String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)

  orderItems    OrderItem[]
  purchaseItems PurchaseItem[]
  stockMoves    StockMove[]

  @@unique([materialId, valueMm])
  @@index([materialId, isActive])
  @@index([tenantId])
}

/// A named size the shop uses often. Punching can pick one or enter a custom
/// size; either way the order stores its own copy of the numbers.
model SizePreset {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId    String
  id          String   @id @default(cuid())
  code        String
  name        String
  lengthMm    Decimal  @db.Decimal(12, 3)
  widthMm     Decimal  @db.Decimal(12, 3)
  thicknessMm Decimal? @db.Decimal(12, 3)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([tenantId, code])
  @@index([isActive, sortOrder])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Configurable status workflow
// ---------------------------------------------------------------------------

/// A named set of statuses and the moves allowed between them. More than one
/// can exist (e.g. a short flow for samples), one is the default.
/// Which entity a workflow drives. Leads and orders share the whole status,
/// hierarchy and transition machinery — and therefore the same admin canvas.
enum WorkflowKind {
  ORDER
  LEAD
}

model Workflow {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId    String
  id          String       @id @default(cuid())
  code        String
  name        String
  description String?
  kind        WorkflowKind @default(ORDER)
  /// One default per kind.
  isDefault   Boolean      @default(false)
  isActive    Boolean      @default(true)

  /// How long an enquiry may sit untouched before it counts as gone quiet, in
  /// days. Null means they never do. Only meaningful on a LEAD workflow: an
  /// order does not go stale, somebody is waiting for it.
  leadExpiryDays Int?

  /// The stage an enquiry moves to when a quote is sent to the client.
  ///
  /// Configured rather than inferred: one shop's pipeline says "Quoted", the
  /// next says "Estimate sent", and a third quotes twice and cares only about
  /// the second. Null means sending a quote records itself against the lead
  /// but moves nothing.
  quoteStatusId String?

  /// The stage an enquiry moves to when the client turns a quote down.
  ///
  /// Configured for the same reason as the one above: one pipeline says "Lost",
  /// another says "Closed — no", and a third keeps declined enquiries where
  /// they are and works them again. Null means a declined quote is recorded
  /// against the enquiry and moves nothing.
  lostStatusId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statuses    WorkflowStatus[]
  transitions WorkflowTransition[]
  orders      Order[]
  leads       Lead[]

  @@unique([tenantId, code])
  @@index([kind, isActive])
  @@index([tenantId])
}

/// System meaning of a status, independent of what the admin names it.
/// Business rules key off this so renaming "In Production" never breaks logic.
enum StatusCategory {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model WorkflowStatus {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId   String
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  code     String
  name     String
  color    String         @default("#6B7785")
  category StatusCategory @default(OPEN)

  /// Status hierarchy: a status may be a child of another, letting the admin
  /// group "Cutting" and "Polishing" under "In Production".
  parentId String?
  parent   WorkflowStatus?  @relation("StatusTree", fields: [parentId], references: [id])
  children WorkflowStatus[] @relation("StatusTree")

  /// Exactly one initial status per workflow; terminal statuses have no
  /// outgoing transitions in normal use.
  isInitial    Boolean @default(false)
  /// A stage an order is allowed to be created at. The journey starts at "Lead"
  /// when an enquiry came first and at "Order confirmed" when it did not, so
  /// more than one stage has to be a legal entry point.
  isEntryPoint Boolean @default(false)
  isTerminal   Boolean @default(false)
  sortOrder    Int     @default(0)

  /// Saved position on the drag-and-drop flow canvas.
  canvasX Float @default(0)
  canvasY Float @default(0)

  /// Where this stage sits on the home screen's summary, or null when it is not
  /// on it. A shop watches a handful of stages day to day — which ones differ
  /// from shop to shop, so they are chosen rather than derived.
  homeCardOrder Int?

  outgoing WorkflowTransition[] @relation("FromStatus")
  incoming WorkflowTransition[] @relation("ToStatus")

  ordersAtStatus  Order[]
  leadsAtStatus   Lead[]
  historyFrom     OrderStatusHistory[] @relation("HistoryFrom")
  historyTo       OrderStatusHistory[] @relation("HistoryTo")
  leadHistoryFrom LeadStatusHistory[]  @relation("LeadHistoryFrom")
  leadHistoryTo   LeadStatusHistory[]  @relation("LeadHistoryTo")

  @@unique([workflowId, code])
  @@index([workflowId, sortOrder])
  @@index([workflowId, homeCardOrder])
  @@index([parentId])
  @@index([tenantId])
}

/// One arrow on the flow canvas.
model WorkflowTransition {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId   String
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  fromStatusId String
  fromStatus   WorkflowStatus @relation("FromStatus", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatusId   String
  toStatus     WorkflowStatus @relation("ToStatus", fields: [toStatusId], references: [id], onDelete: Cascade)

  label        String?
  /// Force the user to explain this move — useful for rejections and holds.
  requiresNote Boolean    @default(false)
  /// Empty means anyone may make the move.
  allowedRoles UserRole[] @default([])

  @@unique([workflowId, fromStatusId, toStatusId])
  @@index([fromStatusId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

enum StorageBackend {
  S3
  DATABASE
}

/// One stored object. Small files can live in Postgres, large ones in S3; the
/// row is the same either way so callers never branch on where a file lives.
model StoredFile {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String         @id @default(cuid())
  backend  StorageBackend

  /// S3 backend
  bucket    String?
  objectKey String?

  /// DATABASE backend. Encrypted when `isEncrypted` is set.
  data Bytes?

  fileName         String
  mimeType         String
  byteSize         Int
  /// Size before image optimisation, so the saving is visible.
  originalByteSize Int?
  width            Int?
  height           Int?
  /// SHA-256 of the stored bytes, for integrity checks and de-duplication.
  checksum         String

  isEncrypted     Boolean @default(false)
  /// Which key version encrypted this, so keys can be rotated.
  encryptionKeyId String?

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  attachments    OrderAttachment[]
  firmLetterhead FirmProfile[]     @relation("FirmLetterhead")
  firmLogo       FirmProfile[]     @relation("FirmLogo")
  expenseBills   Expense[]         @relation("ExpenseBill")
  employeePhotos Employee[]        @relation("EmployeePhoto")

  reports Report[]

  @@index([checksum])
  @@index([createdAt])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// How the GST on an order relates to the figure the client was given.
///
/// The shop quotes in whichever of these three ways the conversation went, and
/// the books have to end up correct either way — so the treatment is stored on
/// the order rather than inferred from the numbers afterwards.
enum TaxTreatment {
  /// The quoted figure is before tax. GST is added on top and the client pays
  /// the larger number. This is the ordinary case.
  EXCLUSIVE
  /// The quoted figure is what the client pays, GST already inside it. The tax
  /// is backed out of that figure rather than added to it.
  INCLUSIVE
  /// The client asked for the GST to be dropped, and the shop agreed to absorb
  /// it. They pay the figure they were quoted, so — like INCLUSIVE — that
  /// figure is what the tax comes out of; what the shop gave up is recorded
  /// separately as a concession.
  ABSORBED
}

model Order {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  code     String

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  /// Free text as typed while punching; the ClientLocation link is set when it
  /// matches a saved site, so both a quick type and a reuse are possible.
  location       String
  locationId     String?
  clientLocation ClientLocation? @relation(fields: [locationId], references: [id])

  workflowId String
  workflow   Workflow       @relation(fields: [workflowId], references: [id])
  statusId   String
  status     WorkflowStatus @relation(fields: [statusId], references: [id])

  priority Priority  @default(NORMAL)
  dueDate  DateTime?
  notes    String?

  /// Money. Under ITEMISED, `subtotal` is the sum of item amounts and `total`
  /// is that less any discount. Under LUMP_SUM, `total` is the figure that was
  /// quoted and the items carry no prices. Both are stored, so an order's value
  /// is a fact rather than a recalculation.
  pricingMode PricingMode @default(ITEMISED)
  subtotal    Decimal     @default(0) @db.Decimal(14, 2)
  discount    Decimal     @default(0) @db.Decimal(14, 2)
  /// Taxable value: subtotal less discount, before GST.
  total       Decimal     @default(0) @db.Decimal(14, 2)

  /// How the quoted figure relates to the GST on it. Under EXCLUSIVE the tax is
  /// added to `total`; under INCLUSIVE and ABSORBED it is taken out of what was
  /// quoted, so `total` is smaller than the figure the client heard.
  taxTreatment TaxTreatment @default(EXCLUSIVE)
  /// What was said to the client, before any of this arithmetic. Kept because
  /// it is the number they will quote back on the phone, and under INCLUSIVE
  /// and ABSORBED it appears nowhere else on the order.
  quotedAmount Decimal      @default(0) @db.Decimal(14, 2)
  /// Under ABSORBED, the GST the shop gave up rather than charge on top. It is
  /// not deducted from anything — the client was never billed it — but the
  /// concession has to be visible or nobody can see what the order really cost
  /// to win.
  taxDiscount  Decimal      @default(0) @db.Decimal(14, 2)

  /// GST. Under ITEMISED this is the sum of the lines' tax. Under LUMP_SUM one
  /// slab applies to the whole quoted figure, so the slab is held here instead.
  gstSlabId  String?
  gstSlab    GstSlab? @relation(fields: [gstSlabId], references: [id])
  taxAmount  Decimal  @default(0) @db.Decimal(14, 2)
  /// What the client actually owes: total + taxAmount. Payments settle against
  /// this, never against the pre-tax figure.
  grandTotal Decimal  @default(0) @db.Decimal(14, 2)

  /// Derived from the payments below and kept here so orders can be filtered
  /// by it without summing a ledger on every query.
  paymentStatus PaymentStatus @default(PENDING)

  createdById String?
  createdBy   User?    @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items         OrderItem[]
  attachments   OrderAttachment[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  disbursements Disbursement[]
  ledgerEntries LedgerEntry[]
  expenses      Expense[]
  stockMoves    StockMove[]
  invoice       Invoice?
  challans      Challan[]
  /// Set when this order came from a lead.
  fromLead      Lead?                @relation("LeadConversion")

  @@unique([tenantId, code])
  @@index([clientId, createdAt])
  @@index([statusId])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([tenantId])
}

/// One punched spec. Dimensions are a snapshot in millimetres — a size preset
/// edited next month must not silently change what was ordered today.
/// How an item is priced. The rate means a different thing in each case, so the
/// unit is stored beside the number rather than assumed.
///
/// LUMP_SUM is not a rate at all — it is the amount itself, for when a price
/// was quoted as one figure for the line rather than derived from its size.
enum RateUnit {
  PER_SQFT
  PER_SQM
  PER_PIECE
  PER_RFT
  LUMP_SUM
}

/// Whether the order's value is built up from its items or was quoted as a
/// single figure.
///
/// This exists because the price has to be recorded the way it was actually
/// given to the client. Someone quoted "₹85 a square foot" and someone quoted
/// "₹40,000 for the job"; storing the second as a back-calculated rate would be
/// inventing a number nobody agreed to, and it would drift the moment a size
/// was corrected.
enum PricingMode {
  ITEMISED
  LUMP_SUM
}

model OrderItem {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNo   Int

  sizePresetId String?
  sizePreset   SizePreset? @relation(fields: [sizePresetId], references: [id])
  lengthMm     Decimal     @db.Decimal(12, 3)
  widthMm      Decimal     @db.Decimal(12, 3)
  thicknessMm  Decimal?    @db.Decimal(12, 3)

  materialId          String
  material            Material           @relation(fields: [materialId], references: [id])
  materialThicknessId String?
  materialThickness   MaterialThickness? @relation(fields: [materialThicknessId], references: [id])

  quantity Int     @default(1)
  notes    String?

  /// Pricing. `amount` is computed from rate, rate unit, size and quantity, and
  /// then stored — a rate edited later must not silently restate what an old
  /// order was worth.
  rate     Decimal? @db.Decimal(14, 2)
  rateUnit RateUnit @default(PER_SQFT)
  amount   Decimal  @default(0) @db.Decimal(14, 2)

  /// GST on what is actually sold. The slab is chosen per line because the
  /// finished product is not the raw board it was cut from. The rate is
  /// snapshotted beside the slab so a later change to the slab cannot restate
  /// an old order's tax.
  gstSlabId  String?
  gstSlab    GstSlab? @relation(fields: [gstSlabId], references: [id])
  gstRatePct Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount  Decimal  @default(0) @db.Decimal(14, 2)

  @@unique([orderId, lineNo])
  @@index([materialId])
  @@index([tenantId])
}

enum AttachmentKind {
  /// What the client wants it to look like. Carries a description.
  REFERENCE_IMAGE
  /// The measured drawing or the tape-on-site photo.
  SIZE_IMAGE
  DOCUMENT
}

model OrderAttachment {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  kind        AttachmentKind
  /// Required for reference images: what the client said about this picture.
  description String?
  sortOrder   Int            @default(0)

  fileId String
  file   StoredFile @relation(fields: [fileId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId, kind, sortOrder])
  @@index([tenantId])
}

/// Every status move, with who made it and why. The audit an admin-configurable
/// workflow needs in order to be trusted.
model OrderStatusHistory {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatusId String?
  fromStatus   WorkflowStatus? @relation("HistoryFrom", fields: [fromStatusId], references: [id])
  toStatusId   String
  toStatus     WorkflowStatus  @relation("HistoryTo", fields: [toStatusId], references: [id])

  note        String?
  /// True when this move went back the way the order came — a move the flow
  /// does not draw, taken deliberately by somebody allowed to. Kept on the row
  /// so the history reads as what happened rather than as an ordinary step.
  reversed    Boolean  @default(false)
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([orderId, changedAt])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

enum PaymentStatus {
  /// Nothing received yet.
  PENDING
  /// Some received, some still owed.
  PARTIAL
  /// Fully paid.
  RECEIVED
}

enum PaymentMode {
  CASH
  ONLINE
}

/// One collection against an order. Orders are usually paid in instalments, so
/// this is a ledger rather than a field — the order's status is derived from
/// the sum, and every receipt keeps its own mode and date.
model Payment {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount Decimal     @db.Decimal(14, 2)
  mode   PaymentMode

  /// UTR, cheque number or whatever identifies an online transfer.
  reference String?
  note      String?

  receivedAt   DateTime @default(now())
  receivedById String?
  receivedBy   User?    @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  createdAt    DateTime @default(now())

  /// The receipt this one takes back, when it is a correction rather than money.
  ///
  /// A receipt is never edited and never deleted. A mistake is corrected by
  /// recording its opposite, which leaves both rows standing: what was entered,
  /// what took it back, who did it and why. That is what makes it impossible
  /// for an order to be made to look settled by money that was never collected.
  reversalOfId String?  @unique
  reversalOf   Payment? @relation("PaymentReversal", fields: [reversalOfId], references: [id])
  reversedBy   Payment? @relation("PaymentReversal")
  /// Why it was taken back. Required to reverse one.
  reason       String?

  /// Only meaningful for CASH: where that cash went afterwards.
  deposits CashDeposit[]

  @@index([orderId, receivedAt])
  @@index([mode])
  @@index([tenantId])
}

/// Cash moving from the shop's hands into the bank.
///
/// A deposit may be tied to the cash payment it came from, which makes an
/// order's cash-in-hand exact. It may also stand alone, because in practice one
/// trip to the bank covers takings from several orders — those reduce the
/// shop's cash position without being attributable to a single order.
model CashDeposit {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId  String
  id        String   @id @default(cuid())
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount        Decimal  @db.Decimal(14, 2)
  depositedAt   DateTime @default(now())
  bankReference String?
  note          String?

  depositedById String?
  depositedBy   User?    @relation("CashDepositedBy", fields: [depositedById], references: [id])
  createdAt     DateTime @default(now())

  /// The deposit this one takes back. Reversing a receipt whose cash had
  /// already been banked has to take the banking back with it, or the shop's
  /// cash position is short by money that never left the drawer.
  reversalOfId String?      @unique
  reversalOf   CashDeposit? @relation("DepositReversal", fields: [reversalOfId], references: [id])
  reversedBy   CashDeposit? @relation("DepositReversal")

  @@index([paymentId])
  @@index([depositedAt])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Disbursements
// ---------------------------------------------------------------------------
//
// Money paid out of an order after the client's money has come in — the fitter,
// the transporter, the installer, whoever else has to be settled once the job
// is done. The shop's accountant reconciles these, so they are ordinary
// payables: the order's own value and payment status are untouched by them.
//
// Deliberately not a reduction of the order. An order quoted at X is worth X
// and is settled when X is collected; what leaves afterwards is a separate
// obligation. Netting the two would understate revenue and put the books out of
// step with the GST already charged on that order.
//
// Every tenant labels these differently — one says ISC, another says site
// charges — so the heading is configuration, not a constant.

enum DisbursementStatus {
  /// Owed, not yet handed over.
  PLANNED
  PAID
  CANCELLED
}

/// A kind of payout, defined per tenant.
model DisbursementCategory {
  id       String @id @default(cuid())
  tenantId String

  code      String
  name      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  disbursements Disbursement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model Disbursement {
  id       String @id @default(cuid())
  tenantId String

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  categoryId String?
  category   DisbursementCategory? @relation(fields: [categoryId], references: [id])

  /// Who the money goes to.
  payeeName    String
  payeeContact String?

  amount Decimal            @db.Decimal(14, 2)
  status DisbursementStatus @default(PLANNED)

  /// How it was settled, once it has been.
  paidAt    DateTime?
  paidMode  PaymentMode?
  reference String?
  note      String?

  /// A payout that has been paid is money that has gone. It is never edited
  /// away and never cancelled: a mistake is corrected by recording its
  /// opposite, so both rows stand and the ledger, this screen and the shop's
  /// own bank statement can all be reconciled against each other. Cancelling
  /// is left for a payout that was only ever planned.
  reversalOfId String?       @unique
  reversalOf   Disbursement? @relation("DisbursementReversal", fields: [reversalOfId], references: [id])
  reversedBy   Disbursement? @relation("DisbursementReversal")
  /// Why it was taken back. Required to reverse one.
  reason       String?

  recordedById String?
  recordedBy   User?    @relation("DisbursementRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, orderId])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// The ledger
// ---------------------------------------------------------------------------
//
// Every rupee that moves posts a row here, whatever moved it: a client's
// payment, a trip to the bank, a payout, and — as they arrive — an expense, a
// purchase bill, a salary.
//
// The tables above keep their own shape, because each carries meaning this one
// does not: a Payment knows which order it settles, a Disbursement knows who is
// owed. What they gain is a posting. Transactions, cash in hand, the reports
// and the accountant's export all read from here, so a money feature that does
// not post is a feature that visibly does not exist rather than one that
// quietly does not count.
//
// The standing rule is unchanged by any of it: payouts are recorded beside
// orders and never netted off them. An order's collected value is the sum of
// its payments; nothing here subtracts from that.

/// Which side of the books an entry belongs to.
enum LedgerDirection {
  /// Money arriving: a client paying.
  IN
  /// Money leaving: a payout, an expense, a salary.
  OUT
  /// Money moving between the shop's own places: cash walked to the bank.
  TRANSFER
}

/// Where the money sat.
enum LedgerAccount {
  CASH
  BANK
}

model LedgerEntry {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())

  /// When the money moved, which is not always when somebody typed it in.
  at        DateTime
  direction LedgerDirection
  /// The account whose balance changed. A transfer names the account the money
  /// left — cash in hand is the number this shop actually asks about, and the
  /// bank's own statement is the truth for the other side.
  account   LedgerAccount

  /// Signed on purpose.
  ///
  /// A correction posts the negative of what it takes back, under the same
  /// direction as the original, so every total is a plain sum and no reader
  /// has to know which kinds cancel which.
  amount Decimal @db.Decimal(14, 2)

  /// The row that caused this, and its table. Unique together, so posting the
  /// same source twice cannot double-count it — which is what makes a
  /// reconcile safe to run whenever.
  sourceType String
  sourceId   String

  orderId  String?
  order    Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Who the money came from or went to, when no row in this database is them.
  party    String?

  /// What an accountant needs, and a screen does not.
  ///
  /// Kept because the shop wants an export their CA can post from: an amount
  /// and a date are a bank statement, not a ledger.
  accountHead String?
  /// RECEIPT | PAYMENT | CONTRA | JOURNAL — the voucher kind Tally and its
  /// like expect.
  voucher     String
  /// The tax inside `amount`, where it is known.
  taxAmount   Decimal? @db.Decimal(14, 2)
  gstin       String?
  reference   String?
  note        String?

  /// Who entered it. Nulled rather than removed if that person's account ever
  /// goes: a money row outlives the staff list.
  recordedById String?
  recordedBy   User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, at])
  @@index([tenantId, direction, at])
  @@index([tenantId, orderId])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

/// Where somebody is with the shop.
///
/// LEFT rather than deleted: an employee who has gone still has last year's
/// attendance and last month's payslip hanging off them, and the accountant
/// will want both.
enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  LEFT
}

/// A person the shop employs.
///
/// Deliberately not the same row as `User`. A login is a way into this system;
/// an employee is somebody who works here. Most of the floor will never have an
/// account, an account can be revoked without the person ceasing to exist, and
/// an office account may belong to somebody who is not on the payroll at all.
/// Where the two are the same person they are linked, and that link is
/// optional in both directions.
model Employee {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  /// EMP-0001, and it does not restart in April: an employee number that
  /// changed with the financial year would be no use to anybody.
  code     String

  name     String
  phone    String?
  altPhone String?
  email    String?

  designation String?
  department  String?

  joinedOn DateTime         @db.Date
  leftOn   DateTime?        @db.Date
  status   EmploymentStatus @default(ACTIVE)

  /// Government identifiers, encrypted at rest.
  ///
  /// The last four digits are kept in clear beside each one because that is
  /// what a screen shows and what somebody reads back over the phone — and
  /// decrypting the whole number to render a list would put every Aadhaar in
  /// the shop through the application for no reason.
  aadhaar      String?
  aadhaarLast4 String?
  pan          String?
  panLast4     String?

  /// Where the salary goes. The account number is encrypted like the rest.
  bankAccountName   String?
  bankAccountNumber String?
  bankAccountLast4  String?
  bankIfsc          String?

  address        String?
  emergencyName  String?
  emergencyPhone String?

  photoFileId String?
  photo       StoredFile? @relation("EmployeePhoto", fields: [photoFileId], references: [id], onDelete: SetNull)

  /// The login, when this person has one. Not every employee does.
  userId String? @unique
  user   User?   @relation("EmployeeLogin", fields: [userId], references: [id], onDelete: SetNull)

  attendance    Attendance[]
  letters       Letter[]
  payStructures PayStructure[]
  advances      SalaryAdvance[]
  payslips      Payslip[]

  createdById String?
  createdBy   User?    @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, department])
  @@index([tenantId])
}

/// What one person's day was.
///
/// A day is one of these, not a number of hours: a shop marks the register in
/// the morning and the accountant is paid to know what "half day" means here.
/// Times are recorded beside it when the shop bothers with them, and ignored
/// when it does not.
enum AttendanceMark {
  PRESENT
  HALF_DAY
  ABSENT
  /// Away with the shop's blessing — paid or not is the pay structure's
  /// business, not this row's.
  LEAVE
  /// The shop was shut: a festival, or the weekly off.
  HOLIDAY
  WEEKLY_OFF
}

/// One person, one day.
///
/// Called marking in and out, never punching. This app already means something
/// specific by *punch* — an order gets punched — and a floor that hears one
/// word for two things will eventually do the wrong one.
model Attendance {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId   String
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date DateTime       @db.Date
  mark AttendanceMark @default(PRESENT)

  /// The clock, where the shop keeps one. Absent is not the same as absent
  /// from work: plenty of shops mark the register and never look at a time.
  inAt            DateTime?
  outAt           DateTime?
  /// Minutes past the ordinary day, which the pay structure decides what to do
  /// with. Held in minutes because half an hour is a real answer.
  overtimeMinutes Int       @default(0)

  note String?

  markedById String?
  markedBy   User?    @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// One row per person per day, so marking the register twice corrects it
  /// rather than counting somebody twice.
  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
  @@index([tenantId, employeeId, date])
  @@index([tenantId])
}

/// How somebody is paid.
///
/// Three kinds rather than one shape, because nobody knows how a given shop
/// pays: the office may be on a monthly salary, the floor on a daily wage, and
/// a polisher on so much a panel. One person can be on more than one at once —
/// a base salary plus a rate per piece is a real arrangement — so a payslip is
/// the sum of their structures rather than a single sum.
enum PayKind {
  MONTHLY
  DAILY
  PIECE
}

/// One way a person is paid, from a given date.
///
/// A raise is a **new row**, not an edit: last month's payslip has to stay
/// explicable after this month's rise, and a rate that changed underneath it
/// would make the two disagree with nobody able to say why.
model PayStructure {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId   String
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  kind       PayKind
  /// The monthly salary, the day's wage, or the rate for one piece.
  rate       Decimal @db.Decimal(14, 2)
  /// PIECE only: what one piece is, in the shop's own word — "panel", "sheet".
  pieceLabel String?

  /// What an hour past the ordinary day is worth. Null means this arrangement
  /// does not pay overtime.
  overtimeHourlyRate Decimal? @db.Decimal(14, 2)

  effectiveFrom DateTime  @db.Date
  /// Closed when a new arrangement replaces this one.
  effectiveTo   DateTime? @db.Date
  note          String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, employeeId, effectiveFrom])
  @@index([tenantId])
}

/// Money handed to somebody against a salary not yet earned.
///
/// It leaves the drawer the day it is given, so it posts to the ledger then —
/// and comes back off the payslip that pays the month it was advanced against.
model SalaryAdvance {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId   String
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  amount  Decimal     @db.Decimal(14, 2)
  givenOn DateTime    @db.Date
  mode    PaymentMode
  note    String?

  /// How much of it a payslip has taken back so far. An advance is recovered
  /// in instalments when one month's pay cannot carry all of it.
  recoveredAmount Decimal @default(0) @db.Decimal(14, 2)

  givenById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, employeeId])
  @@index([tenantId, givenOn])
  @@index([tenantId])
}

/// Where a month's pay has got to.
///
/// A draft can be changed and thrown away. Once it is paid the money has gone,
/// so it is fixed: a correction is next month's adjustment, not a rewrite of
/// what was handed over.
enum SalaryRunStatus {
  DRAFT
  APPROVED
  PAID
}

/// One month's pay for the whole shop.
model SalaryRun {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())

  /// The month it pays for, held as its first day.
  month  DateTime        @db.Date
  status SalaryRunStatus @default(DRAFT)

  /// How many days the shop counts as a full month.
  ///
  /// Stated by the shop rather than counted off a calendar: some pay for 26
  /// days and some for 30, and a monthly salary is divided by whichever this
  /// shop means. Kept on the run so last March's payslips still divide by what
  /// last March used.
  workingDays Int

  note String?

  approvedAt DateTime?
  paidAt     DateTime?
  /// How the money went out, once it has.
  paidMode   PaymentMode?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payslips Payslip[]

  /// One run per month, so a shop cannot pay February twice by accident.
  @@unique([tenantId, month])
  @@index([tenantId, status])
  @@index([tenantId])
}

/// What one person is paid for one month, and why.
model Payslip {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId   String
  id         String    @id @default(cuid())
  runId      String
  run        SalaryRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// What the register came to, copied here rather than looked up later.
  ///
  /// A payslip has to explain itself after somebody corrects the attendance or
  /// changes the pay structure — and it cannot do that if it fetches both
  /// again every time it is opened.
  payableDays     Decimal @db.Decimal(6, 2)
  overtimeMinutes Int     @default(0)
  /// PIECE work: how many, entered by the shop for this month.
  pieces          Int?

  /// Every line that made the gross, snapshotted the same way.
  /// `[{ kind, label, rate, quantity, amount }]`
  lines Json

  gross           Decimal @db.Decimal(14, 2)
  /// Advances taken back this month.
  advanceDeducted Decimal @default(0) @db.Decimal(14, 2)
  /// Which advance gave back how much: `[{ advanceId, amount }]`.
  ///
  /// The total alone would not do. Crediting every advance an employee holds
  /// with the whole deduction would mark two of them repaid on one month's
  /// recovery, and the shop would never see the money again.
  recoveries      Json?
  /// Anything else the shop is holding back, with a reason.
  otherDeductions Decimal @default(0) @db.Decimal(14, 2)
  deductionNote   String?
  net             Decimal @db.Decimal(14, 2)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, runId, employeeId])
  @@index([tenantId, employeeId])
  @@index([tenantId])
}

/// The letters a shop gives its people.
///
/// A fixed set of kinds, because these are the ones an Indian shop is actually
/// asked for and each has a shape the recipient's bank or landlord expects.
/// What each one *says* is the shop's, through a template it edits.
enum LetterKind {
  OFFER
  APPOINTMENT
  /// What somebody may not repeat outside.
  NDA
  /// What the job actually is, signed.
  RESPONSIBILITY
  EXPERIENCE
  RELIEVING
  WARNING
}

/// What a letter says, before it is about anybody.
///
/// The shop writes these. Placeholders in double braces — `{{name}}`,
/// `{{designation}}` — are filled in when a letter is issued, and the filled-in
/// version is what gets kept.
model LetterTemplate {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String     @id @default(cuid())
  kind     LetterKind
  name     String
  body     String
  isActive Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, kind, isActive])
  @@index([tenantId])
}

/// A letter somebody was actually given.
model Letter {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId   String
  id         String     @id @default(cuid())
  employeeId String
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       LetterKind

  title String
  /// The body as it was printed, with the placeholders already filled in.
  ///
  /// Snapshotted on purpose. A template edited next year must not change what
  /// somebody was handed last March — the copy in their file is the one that
  /// counts, and this is ours.
  body  String

  issuedOn   DateTime @db.Date
  issuedById String?
  createdAt  DateTime @default(now())

  @@index([tenantId, employeeId, issuedOn])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Buying, stock and waste
// ---------------------------------------------------------------------------
//
// A purchase bill is the source of anything that becomes stock; an `Expense` is
// spend that does not. Both post to the ledger, so neither can hide from
// Transactions — and the line between them is the only rule anybody has to
// remember when deciding where a payment goes.

/// Somebody the shop buys from.
///
/// A separate model from `Client` although the columns rhyme: the same firm is
/// occasionally both, and merging them would mean one screen listing everybody
/// the shop deals with in either direction, with no way to say which way.
model Vendor {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  code     String
  name     String

  phone    String?
  altPhone String?
  email    String?
  gstin    String?
  /// The trading name on their paperwork, which is rarely the person's name.
  company  String?

  /// Their state, as the GST code and name ("08-Rajasthan"). It decides whether
  /// a purchase is intra-state (CGST + SGST) or inter-state (IGST), so a bill
  /// cannot be entered correctly without it.
  stateCode String?
  stateName String?

  address  String?
  notes    String?
  /// What the shop buys from them, in its own words — "boards", "hardware".
  supplies String?

  /// How long they usually take to be paid, in days. Nothing is enforced on
  /// it; it is what the shop tells itself when deciding what to order.
  paymentTermDays Int?

  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("VendorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases Purchase[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([tenantId])
}

/// One order placed on a vendor, and the bill it becomes.
///
/// Ordering and billing are the same row rather than two. A shop this size
/// sends an order and gets a bill against it; splitting them would mean two
/// documents to reconcile for the one conversation that actually happened.
/// What separates them is time: `billNumber` and `billedOn` are the vendor's
/// paperwork, filled in when it arrives.
model Purchase {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  /// PO-2627-0001. Dated, because the shop's own paperwork is.
  code     String

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  status PurchaseStatus @default(DRAFT)

  orderedOn  DateTime? @db.Date
  /// When the vendor says it will arrive. Not enforced; it is what the shop
  /// chases against.
  expectedOn DateTime? @db.Date

  /// The vendor's own bill, once there is one.
  billNumber String?
  billedOn   DateTime? @db.Date

  /// Where the money went, once it has. A purchase can be received and unpaid
  /// for weeks — that is the normal case, and the reason this is nullable.
  paidOn   DateTime?    @db.Date
  paidMode PaymentMode?

  /// The totals, held rather than recomputed on every read.
  ///
  /// A bill from a vendor is a document with figures on it, and those figures
  /// are what the shop owes whatever this system would have calculated. When
  /// they disagree the bill wins, and the difference is somebody's to look at.
  subtotal Decimal @default(0) @db.Decimal(14, 2)
  taxTotal Decimal @default(0) @db.Decimal(14, 2)
  total    Decimal @default(0) @db.Decimal(14, 2)

  /// Anything on the bill that is not a line: freight, loading, a round-off.
  otherCharges Decimal @default(0) @db.Decimal(14, 2)
  note         String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items      PurchaseItem[]
  stockMoves StockMove[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, vendorId])
  @@index([tenantId])
}

/// One line of a purchase: a material, a thickness, a quantity and a rate.
model PurchaseItem {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId   String
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  materialId  String
  material    Material           @relation(fields: [materialId], references: [id])
  thicknessId String?
  thickness   MaterialThickness? @relation(fields: [thicknessId], references: [id])

  /// What one of them is: a sheet, a kilo, a length. The shop's own word,
  /// because a "sheet" of 18mm ply and a "kilo" of brass are both one line.
  unit String @default("sheet")

  quantity   Decimal @db.Decimal(14, 3)
  rate       Decimal @db.Decimal(14, 2)
  /// The tax on this line, as a rate and as an amount. Copied off the bill
  /// rather than derived: a vendor's arithmetic is what the shop owes.
  gstRatePct Decimal @default(0) @db.Decimal(5, 2)
  taxAmount  Decimal @default(0) @db.Decimal(14, 2)
  lineTotal  Decimal @db.Decimal(14, 2)

  /// How much of this line has actually turned up.
  receivedQuantity Decimal @default(0) @db.Decimal(14, 3)

  note String?

  stockMoves StockMove[]

  @@index([tenantId, purchaseId])
  @@index([tenantId, materialId])
  @@index([tenantId])
}

/// Every change to what is on the rack.
///
/// Signed: a receipt is positive, a consumption negative. The quantity on hand
/// is the sum of these rows and nothing else — no level anybody can type over,
/// because a figure that can be overwritten is a figure with no explanation
/// behind it. "Where did four sheets go" is the question this table answers.
model StockMove {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())

  materialId  String
  material    Material           @relation(fields: [materialId], references: [id])
  thicknessId String?
  thickness   MaterialThickness? @relation(fields: [thicknessId], references: [id])

  kind     StockMoveKind
  /// Signed, in the material's own unit. Negative takes stock off the rack.
  quantity Decimal       @db.Decimal(14, 3)
  unit     String        @default("sheet")

  /// What it cost, per unit, when that is known.
  ///
  /// Carried on the move rather than on the material so a rack holding sheets
  /// bought at two prices can still be valued: the shop paid what it paid, and
  /// averaging it away at the door loses the only figure an accountant wants.
  rate Decimal? @db.Decimal(14, 2)

  /// Where it came from, or went.
  purchaseId     String?
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseItemId String?
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Why, in the shop's words. Required for waste and for an adjustment: a
  /// sheet that vanished with no reason beside it is the thing this module
  /// exists to stop.
  reason String?
  note   String?

  at           DateTime @db.Date
  recordedById String?
  recordedBy   User?    @relation("StockMoveBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([tenantId, materialId, thicknessId])
  @@index([tenantId, kind, at])
  @@index([tenantId, orderId])
  @@index([tenantId])
}

/// Where a purchase has got to.
///
/// DRAFT is a list somebody is still writing. ORDERED has been sent. Goods
/// arrive against it — possibly in more than one delivery — and it is RECEIVED
/// when everything ordered has come, PART_RECEIVED while some has.
enum PurchaseStatus {
  DRAFT
  ORDERED
  PART_RECEIVED
  RECEIVED
  CANCELLED
}

/// What a movement of stock was.
///
/// Every change to what is on the rack is one of these rows, and the quantity
/// on hand is their sum. Nothing sets a level directly: a figure that could be
/// typed over is a figure with no explanation behind it, and "where did four
/// sheets go" is the question this module exists to answer.
enum StockMoveKind {
  /// A delivery arrived against a purchase.
  RECEIPT
  /// Issued to an order and cut.
  CONSUMPTION
  /// The usable remainder of a sheet, back on the rack.
  OFFCUT
  /// Cut away and gone: the kerf, the trim, the piece that broke.
  WASTE
  /// A count found something different from the books.
  ADJUSTMENT
  /// Sent back to the vendor.
  RETURN
}

// ---------------------------------------------------------------------------
// Documents: invoices, challans and credit notes
// ---------------------------------------------------------------------------
//
// None of these post to the ledger, and that is deliberate. An invoice is a
// claim, not a movement of money; the payment against it is the movement, and
// that already posts. Posting both would count the same rupees twice, and the
// cash position — the figure this shop actually asks about — would be wrong by
// everything it had billed and not yet been paid.

/// Where a document stands.
///
/// A number, once used, is used. An invoice is cancelled rather than deleted
/// and its number is never reissued: a gap in the series is the first thing an
/// assessing officer asks about.
enum DocumentStatus {
  ISSUED
  CANCELLED
}

/// A tax invoice, raised from an order.
///
/// One per order. Progressive billing would mean deciding which lines belong
/// to which invoice, and this shop bills a job when it goes out — so a
/// correction is a credit note rather than a second invoice, which is what the
/// GST rules expect anyway.
///
/// Everything on it is snapshotted. An invoice printed next year has to be the
/// document that was issued, not a fresh render of whatever the client's
/// address and the shop's rates happen to be by then.
model Invoice {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  /// INV-2627-0001, gapless within the financial year.
  code     String

  orderId String         @unique
  order   Order          @relation(fields: [orderId], references: [id])
  status  DocumentStatus @default(ISSUED)

  issuedOn DateTime  @db.Date
  /// When it is due, from the terms agreed. Nothing chases it yet.
  dueOn    DateTime? @db.Date

  /// The client, as they were when it was raised.
  clientName    String
  clientGstin   String?
  clientAddress String?
  clientState   String?
  /// The shop, as it was when it was raised.
  firmName      String
  firmGstin     String?
  firmState     String?

  /// True when the two states differ: IGST rather than CGST + SGST. Decided
  /// once, here, so a reprint cannot change which pair is on the paper.
  interState Boolean @default(false)

  /// The money, snapshotted from the order.
  subtotal     Decimal @db.Decimal(14, 2)
  discount     Decimal @default(0) @db.Decimal(14, 2)
  taxable      Decimal @db.Decimal(14, 2)
  cgst         Decimal @default(0) @db.Decimal(14, 2)
  sgst         Decimal @default(0) @db.Decimal(14, 2)
  igst         Decimal @default(0) @db.Decimal(14, 2)
  total        Decimal @db.Decimal(14, 2)
  /// The total in words, as it has to appear on the paper.
  totalInWords String

  terms String?
  note  String?

  /// Why it was cancelled. Required to cancel one.
  cancelReason String?
  cancelledAt  DateTime?

  issuedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items       InvoiceItem[]
  creditNotes CreditNote[]

  @@unique([tenantId, code])
  @@index([tenantId, issuedOn])
  @@index([tenantId, status])
  @@index([tenantId])
}

/// One line of an invoice, as it was printed.
model InvoiceItem {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId  String
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// Free text, snapshotted: the material and size as they were described.
  description String
  /// The HSN code, which a tax invoice has to carry.
  hsn         String?
  quantity    Decimal @db.Decimal(14, 3)
  unit        String  @default("nos")
  rate        Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)
  gstRatePct  Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)

  sortOrder Int @default(0)

  @@index([tenantId, invoiceId])
  @@index([tenantId])
}

/// A delivery challan: what went out of the door.
///
/// No prices on it. A challan travels with the goods and is read by whoever
/// receives them; what the job cost is between the shop and whoever ordered it.
model Challan {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  /// DC-2627-0001.
  code     String

  orderId String
  order   Order          @relation(fields: [orderId], references: [id])
  status  DocumentStatus @default(ISSUED)

  issuedOn  DateTime @db.Date
  /// Where it went, which is not always the client's billing address.
  shipTo    String?
  /// Who carried it, and on what.
  transport String?
  vehicle   String?

  note         String?
  cancelReason String?
  cancelledAt  DateTime?

  issuedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items ChallanItem[]

  @@unique([tenantId, code])
  @@index([tenantId, orderId])
  @@index([tenantId])
}

/// One line of a challan: what it was and how many, and nothing about money.
model ChallanItem {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId  String
  id        String  @id @default(cuid())
  challanId String
  challan   Challan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal @db.Decimal(14, 3)
  unit        String  @default("nos")
  sortOrder   Int     @default(0)

  @@index([tenantId, challanId])
  @@index([tenantId])
}

/// Why a credit note was raised.
///
/// Named rather than free text because the reason changes what an accountant
/// does with it, and because "why is this client being charged less" is a
/// question the owner should be able to answer from a list.
enum CreditReason {
  /// Goods came back.
  RETURN
  /// The rate or the quantity on the invoice was wrong.
  CORRECTION
  /// Agreed after the fact — a discount, a settlement.
  ALLOWANCE
  /// The work was not done, or not to standard.
  CANCELLED_WORK
}

/// A credit note against an invoice.
///
/// It reduces what the client owes; it is not a payment and never counts as
/// one. Whatever is credited appears on the order as its own line, beside what
/// was actually collected — an order that was billed ₹50,000, credited ₹5,000
/// and paid ₹45,000 is settled, and the paper says exactly that rather than
/// showing ₹50,000 received.
model CreditNote {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  /// CN-2627-0001.
  code     String

  invoiceId String
  invoice   Invoice        @relation(fields: [invoiceId], references: [id])
  status    DocumentStatus @default(ISSUED)

  issuedOn DateTime     @db.Date
  reason   CreditReason
  /// In the shop's own words, and required. A figure that reduced what somebody
  /// owed with no sentence beside it is the thing the books must never carry.
  note     String

  /// The money. The GST is reversed in the same proportion the invoice charged
  /// it, so a credit note against an IGST invoice reverses IGST.
  taxable      Decimal @db.Decimal(14, 2)
  cgst         Decimal @default(0) @db.Decimal(14, 2)
  sgst         Decimal @default(0) @db.Decimal(14, 2)
  igst         Decimal @default(0) @db.Decimal(14, 2)
  total        Decimal @db.Decimal(14, 2)
  totalInWords String

  cancelReason String?
  cancelledAt  DateTime?

  issuedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, invoiceId])
  @@index([tenantId, issuedOn])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

/// Which dropdown an option feeds.
///
/// The set is fixed because each one is a column on Expense; what goes *in*
/// each is the shop's to decide, which is the point of the whole model.
enum ExpenseOptionField {
  PAYMENT_TYPE
  DONE_BY
  VENDOR
  SPENT_TYPE
  TO_NAME
}

/// A choice on the expense form, editable by the shop rather than by us.
///
/// This is the reason an expense screen never needs a developer: a shop that
/// starts buying from a new supplier, or hires someone who will be paying for
/// things, adds the name itself. Every list on the form comes from here.
model ExpenseOption {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String             @id @default(cuid())
  field    ExpenseOptionField
  /// Stored as it is displayed, and stored on the expense in the same form —
  /// see Expense.paymentType for why.
  label    String

  /// PAYMENT_TYPE only: which account this way of paying comes out of.
  ///
  /// Cash and a bank transfer are the same expense and a different drawer, and
  /// nothing but the shop can say which of its own payment types is which.
  account LedgerAccount?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, field, label])
  @@index([tenantId, field, isActive])
  @@index([tenantId])
}

/// Money the shop spent.
///
/// Everything the business pays for that is not a payout against a particular
/// order: rent, diesel, a router bit, tea. It posts to the ledger like every
/// other movement of money, so cash spent leaves the drawer and the shop's own
/// figure for what is in it stays true.
model Expense {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())

  /// The day the money was spent, which is not the day somebody typed it in.
  date        DateTime @db.Date
  description String
  amount      Decimal  @db.Decimal(14, 2)

  /// The five dropdowns, stored as labels rather than as ids.
  ///
  /// Renaming an option — or retiring it — must not change what an expense
  /// from last March says it was, and an export a CA reads should not be a
  /// page of identifiers. Filtering matches on the label.
  paymentType String
  doneBy      String
  toName      String
  vendor      String
  spentType   String
  note        String?

  /// What the accountant needs, and the form should not insist on.
  ///
  /// An expense whose tax cannot be claimed is a different number to them, so
  /// the GSTIN and the split are recorded when they are known and left alone
  /// when they are not.
  vendorGstin  String?
  taxableValue Decimal? @db.Decimal(14, 2)
  taxAmount    Decimal? @db.Decimal(14, 2)
  itcEligible  Boolean  @default(false)

  /// The bill, photographed at the counter.
  billFileId String?
  bill       StoredFile? @relation("ExpenseBill", fields: [billFileId], references: [id], onDelete: SetNull)

  /// Optional, for job costing later: what this was spent on.
  ///
  /// It never reduces what the order collected — an order quoted at ₹X is
  /// worth ₹X. This says which job the cost belongs to, nothing more.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// An expense is never deleted. A duplicate typed at the counter, or one
  /// that turned out never to have happened, is corrected by recording its
  /// opposite — which leaves both rows standing: what was entered, what took
  /// it back, who did it and why. The books and this screen then agree without
  /// either of them having to forget something.
  reversalOfId String?  @unique
  reversalOf   Expense? @relation("ExpenseReversal", fields: [reversalOfId], references: [id])
  reversedBy   Expense? @relation("ExpenseReversal")
  /// Why it was taken back. Required to reverse one.
  reason       String?

  editHistory ExpenseEditHistory[]

  createdById String?
  createdBy   User?    @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, date])
  @@index([tenantId, spentType])
  @@index([tenantId, vendor])
  @@index([tenantId, doneBy])
  @@index([tenantId, paymentType])
  @@index([tenantId, orderId])
  @@index([tenantId])
}

/// What changed on an expense, and why somebody changed it.
///
/// The audit trail records every write in this database already. This sits
/// beside it because an expense is corrected for a reason a person types at
/// the time — "the bill was for two sheets, not three" — and that sentence
/// belongs on the screen the correction was made on, next to the fields it
/// explains, rather than in a general log somebody has to go looking through.
///
/// `changes` is a JSON array of `{ field, from, to }` rather than a column per
/// field, because the expense has many mutable columns and adding one should
/// not need a migration here as well.
model ExpenseEditHistory {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId  String
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  /// CREATED | UPDATED | REVERSED — what happened, in one word.
  editType String
  changes  Json
  /// Why. Typed by whoever made the change, and the reason this model exists.
  note     String?

  /// Who did it, and their name at the time.
  ///
  /// The name is copied rather than only referenced so the log still reads
  /// after that person's account is gone — which is the moment somebody is
  /// most likely to be reading it.
  userId   String?
  user     User?   @relation("ExpenseEditBy", fields: [userId], references: [id], onDelete: SetNull)
  userName String?

  createdAt DateTime @default(now())

  @@index([tenantId, expenseId, createdAt])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

/// Where an enquiry came from. Admin-managed so the list matches how this shop
/// actually gets work, rather than a fixed set someone guessed.
model LeadSource {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId  String
  id        String  @id @default(cuid())
  code      String
  name      String
  color     String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  leads Lead[]

  @@unique([tenantId, code])
  @@index([isActive, sortOrder])
  @@index([tenantId])
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  PHONE
  EMAIL
}

enum CustomFieldEntity {
  LEAD
  ORDER
  CLIENT
}

/// Admin-defined fields. The shop can capture whatever it needs on a lead —
/// site area, architect's name, budget band — without a schema change, and the
/// forms build themselves from these rows.
model CustomFieldDefinition {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId  String
  id        String            @id @default(cuid())
  entity    CustomFieldEntity
  key       String
  label     String
  type      CustomFieldType   @default(TEXT)
  /// Choices for SELECT and MULTI_SELECT.
  options   String[]          @default([])
  helpText  String?
  required  Boolean           @default(false)
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([tenantId, entity, key])
  @@index([entity, isActive, sortOrder])
  @@index([tenantId])
}

/// An enquiry, before it is work.
///
/// A lead may name an existing client or just a person who rang; the contact
/// fields cover the second case so nothing is lost while it is still vague.
model Lead {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  code     String
  title    String

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  contactName  String?
  contactPhone String?
  contactEmail String?
  company      String?
  location     String?

  sourceId String?
  source   LeadSource? @relation(fields: [sourceId], references: [id])

  workflowId String
  workflow   Workflow       @relation(fields: [workflowId], references: [id])
  statusId   String
  status     WorkflowStatus @relation(fields: [statusId], references: [id])

  ownerId String?
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id])

  estimatedValue Decimal?  @db.Decimal(14, 2)
  /// What was actually quoted, taken from the estimate that was sent.
  ///
  /// Kept beside the guess rather than overwriting it: `estimatedValue` is what
  /// somebody thought the job was worth when the phone was put down, and the
  /// difference between the two is worth being able to see. Where this is set
  /// it is the figure the pipeline is worth.
  quotedValue    Decimal?  @db.Decimal(14, 2)
  expectedDate   DateTime?
  priority       Priority  @default(NORMAL)
  notes          String?

  /// Values for the admin-defined fields above, keyed by their `key`.
  customFields Json @default("{}")

  /// Set once the lead becomes work. Kept rather than deleted so the pipeline
  /// can report how many enquiries actually converted.
  convertedOrderId String?   @unique
  convertedOrder   Order?    @relation("LeadConversion", fields: [convertedOrderId], references: [id])
  convertedAt      DateTime?

  createdById String?
  createdBy   User?    @relation("LeadCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  statusHistory LeadStatusHistory[]
  estimates     Estimate[]

  @@unique([tenantId, code])
  @@index([statusId])
  @@index([ownerId])
  @@index([createdAt])
  @@index([tenantId])
}

model LeadStatusHistory {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromStatusId String?
  fromStatus   WorkflowStatus? @relation("LeadHistoryFrom", fields: [fromStatusId], references: [id])
  toStatusId   String
  toStatus     WorkflowStatus  @relation("LeadHistoryTo", fields: [toStatusId], references: [id])

  note        String?
  /// True when the enquiry went back a stage. See OrderStatusHistory.reversed.
  reversed    Boolean  @default(false)
  changedById String?
  changedBy   User?    @relation("LeadStatusChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([leadId, changedAt])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

/// Runtime configuration the admin can change without a deploy: default
/// display unit, image optimisation targets, storage backend preference.
/// Something that happened, that somebody should know about.
///
/// The row is the source of truth, not the push. A phone that was off, a person
/// who was on leave, an app that was never installed — the notification is
/// still here when they open the product, which is what makes it worth
/// building before the transport that wakes the phone exists.
model Notification {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())

  /// Who it is for. One row per person, so read state is theirs alone.
  userId String
  user   User   @relation("NotificationFor", fields: [userId], references: [id], onDelete: Cascade)

  /// The registry key it was raised under: `order.moved`, `payment.recorded`.
  /// A string rather than an enum, so a new trigger is a release rather than a
  /// migration.
  kind String

  /// Rendered when it happened, and kept. Editing a template later must not
  /// rewrite what people were already told.
  title String
  body  String

  /// What it is about, so tapping it can open the thing itself.
  entity   String?
  entityId String?

  /// Who caused it, for "Rajat moved it" rather than "it moved".
  actorId String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, userId, readAt])
}

/// A shop's own wording for one kind of notification.
///
/// The triggers are the product's; what they say is the shop's. A row here
/// overrides the default for one key — and can switch it off entirely, because
/// a notification nobody wants is worse than none.
model NotificationTemplate {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String  @id @default(cuid())
  key      String
  title    String?
  body     String?
  enabled  Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model AppSetting {
  id        String   @id @default(cuid())
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId  String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// Atomic counters behind human-readable document numbers. A read-then-increment
/// on the documents themselves loses races.
model DocumentSequence {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId  String
  id        String   @id @default(cuid())
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model AuditLog {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId   String
  id         String   @id @default(cuid())
  entity     String
  entityId   String
  /// Something a person recognises without a join — ORD-2627-0003, a client's
  /// name — so a history reads on its own and survives the row being deleted.
  entityCode String?
  /// What happened: `order.updated`, `order.moved_back`, `payment.reversed`.
  action     String
  /// Only the fields that differed, both sides. A whole-row copy makes a
  /// history nobody reads and a table nobody can afford.
  before     Json?
  after      Json?
  /// Why, when somebody said. The half a diff cannot hold.
  reason     String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  /// Who, when they are not a user of this workspace — a platform admin
  /// helping, or a scheduled job.
  actorLabel String?
  /// What this row belongs to, when it is part of something bigger: a line on
  /// an order, a payment against it, a location under a client. Without it an
  /// order's history would show the order's own columns changing and nothing
  /// about the lines and the money underneath, which is where the argument
  /// usually is.
  rootEntity String?
  rootId     String?
  createdAt  DateTime @default(now())

  @@index([rootEntity, rootId, createdAt])
  @@index([entity, entityId, createdAt])
  @@index([createdAt])
  @@index([tenantId])
}

/// The shop's own details, as they appear on anything it prints.
///
/// One row per tenant. Estimates and invoices are rendered from this rather
/// than from a stored letterhead image alone, so a firm that changes its phone
/// number does not have to re-upload artwork — but an uploaded letterhead is
/// honoured where one exists, because most firms already have one they like.
model FirmProfile {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String @id
  id       String @unique @default(cuid())

  name      String
  gstin     String?
  /// GST state code and name, e.g. "08" / "Rajasthan". Compared against the
  /// client's to decide CGST+SGST versus IGST.
  stateCode String?
  stateName String?
  phone     String?
  email     String?
  address   String?
  website   String?

  /// Printed under the totals so the client knows where to send the money.
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?

  /// The numbered block at the foot of an estimate. Free text, because every
  /// shop's terms are their own.
  termsAndConditions String?
  /// Printed above the signature line.
  signatoryName      String?

  /// An uploaded letterhead, drawn as the page background. When absent the
  /// document draws its own header from the fields above.
  letterheadFileId String?
  letterheadFile   StoredFile? @relation("FirmLetterhead", fields: [letterheadFileId], references: [id])
  logoFileId       String?
  logoFile         StoredFile? @relation("FirmLogo", fields: [logoFileId], references: [id])

  /// The accent used on printed documents — estimates, bills. Kept separate
  /// from the app's accent below, because a letterhead's red and a screen's
  /// orange are different decisions and a firm may well want both.
  accentColor String @default("#E4232F")

  /// The app and web accent, so a client's software can carry their own brand
  /// colour rather than ours. One colour rather than a palette: on a soft-UI
  /// theme the greys are structural — they are what makes a surface look
  /// pressed out of the ground — and only the accent is really theirs to pick.
  themeAccent String @default("#FF6B1A")

  updatedAt DateTime @updatedAt
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  /// Turned into an order. The estimate stays as the record of what was quoted.
  CONVERTED
}

/// A priced quotation given to a client before any order exists.
///
/// Deliberately not an Order: most estimates never become one, and the numbers
/// on an estimate are a proposal that can be revised, while an order's are a
/// fact that must not move. Converting copies the figures across.
model Estimate {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId String
  id       String @id @default(cuid())
  /// Human-readable, from the same atomic counter the order numbers use.
  code     String

  clientId   String?
  client     Client? @relation(fields: [clientId], references: [id])
  /// A name typed on the spot, for a quote given before the client exists.
  clientName String?

  /// Snapshotted at issue: an estimate printed last month must still show the
  /// address it was sent to, whatever the client record says today.
  billingAddress  String?
  shippingAddress String?
  clientGstin     String?
  clientStateCode String?

  status        EstimateStatus @default(DRAFT)
  issuedOn      DateTime       @default(now())
  validTill     DateTime?
  notes         String?
  /// Overrides the firm's standing terms for this one document.
  termsOverride String?

  /// How the GST on this estimate relates to the figures quoted, exactly as on
  /// an order.
  taxTreatment TaxTreatment @default(EXCLUSIVE)

  /// Money, all snapshotted. `subtotal` is before discount, `total` is the
  /// taxable value after it, and `grandTotal` is what the client would pay.
  subtotal    Decimal @default(0) @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @default(0) @db.Decimal(14, 2)
  /// Split out because an Indian invoice must show them separately. Intra-state
  /// fills cgst and sgst; inter-state fills igst.
  cgst        Decimal @default(0) @db.Decimal(14, 2)
  sgst        Decimal @default(0) @db.Decimal(14, 2)
  igst        Decimal @default(0) @db.Decimal(14, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)
  grandTotal  Decimal @default(0) @db.Decimal(14, 2)
  /// Discount plus the tax that would have been charged on it — the figure the
  /// sample estimate prints as "You saved".
  savedAmount Decimal @default(0) @db.Decimal(14, 2)

  /// Set when this estimate became an order.
  orderId String? @unique

  /// The enquiry this was quoted for, where there was one.
  ///
  /// Optional on purpose: most estimates are for a client who rang up and
  /// asked for a price, and making every quote wait for an enquiry to be
  /// raised first would put a step in front of the commonest job in the shop.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  createdById String?
  createdBy   User?    @relation("EstimateCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items EstimateItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([leadId])
}

/// One priced line on an estimate.
///
/// Free-form rather than tied to a material and a size preset: a quotation is
/// often written before anything has been measured, and forcing it through the
/// punch form would make quoting slower than writing it out by hand.
model EstimateItem {
  /// Owning tenant. No FK: a dedicated database holds no Tenant row.
  tenantId   String
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  lineNo     Int

  name        String
  description String?
  /// HSN for goods, SAC for services. Printed as one column, as on the sample.
  hsnSac      String?

  quantity    Decimal @default(1) @db.Decimal(12, 3)
  /// The unit as the shop says it — "Sqf", "Rft", "Nos".
  unit        String  @default("Sqf")
  ratePerUnit Decimal @default(0) @db.Decimal(14, 2)

  /// Per-line discount, held as both so the printed document can show the
  /// percentage that was agreed alongside the money it came to.
  discountPct    Decimal @default(0) @db.Decimal(5, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)

  gstSlabId  String?
  gstSlab    GstSlab? @relation(fields: [gstSlabId], references: [id])
  gstRatePct Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount  Decimal  @default(0) @db.Decimal(14, 2)

  /// Taxable value after the line discount.
  netAmount Decimal @default(0) @db.Decimal(14, 2)
  /// What this line comes to including its GST — the sample's "Amount".
  amount    Decimal @default(0) @db.Decimal(14, 2)

  @@unique([estimateId, lineNo])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Reports
// ---------------------------------------------------------------------------

enum ReportStatus {
  QUEUED
  GENERATING
  READY
  FAILED
  EXPIRED
}

enum ReportFormat {
  XLSX
  PDF
}

/// A report somebody asked for, and what became of it.
///
/// Asked for on one request and built on another, because a GST quarter is not
/// something to hold an HTTP connection open for. The row outlives the file it
/// produced: retention drops the bytes and keeps the row, so "who exported the
/// payout ledger, and when" survives the disk space.
model Report {
  tenantId String
  id       String @id @default(cuid())

  /// A ReportKind from @fas/shared. A string rather than a database enum so
  /// that adding a report is a code change and not a migration — the same
  /// choice LedgerEntry.sourceType makes, for the same reason.
  kind   String
  format ReportFormat
  status ReportStatus @default(QUEUED)

  /// The window asked for. Both null when the report has no period.
  fromDate DateTime? @db.Date
  toDate   DateTime? @db.Date
  /// Whatever else narrowed it — a client, an employee.
  params   Json?

  /// Where the bytes went. Nulled by retention; the row stays.
  fileId   String?
  file     StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  rowCount Int?

  startedAt  DateTime?
  finishedAt DateTime?
  /// Why it failed, in words the person who asked will read.
  error      String?
  /// After this the file goes. The row does not.
  expiresAt  DateTime?

  requestedById String?
  requestedBy   User?   @relation("ReportRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, kind, createdAt])
  @@index([tenantId, createdAt])
}
