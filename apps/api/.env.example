DATABASE_URL="postgresql://nakulvarshney@localhost:5432/fas?schema=public"
# What migrations connect with. In production DATABASE_URL points at a
# connection pooler and this points straight at Postgres — a pooler in
# transaction mode cannot hold the session a migration needs. Locally they are
# the same string.
DIRECT_URL="postgresql://nakulvarshney@localhost:5432/fas?schema=public"
PORT=3001
# Which deployment this is: development | staging | production.
# Reported by GET /api/health, so nobody has to guess whether they are
# looking at staging or at a shop's live data.
APP_ENV=development
# Stamped by the deploy, so an error report can be tied to a build.
# APP_VERSION=
# APP_COMMIT=
JWT_SECRET="dev-only-change-in-production"
JWT_EXPIRES_IN="12h"
UPLOAD_DIR="./uploads"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

ENCRYPTION_KEYS="k1:<base64 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))">"
STORAGE_DB_MAX_BYTES=1048576
# S3 is optional; without it every file is stored in Postgres.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Signs the updates the app is served.
#
# The certificate half is committed at apps/mobile/certs/certificate.pem and is
# baked into the binary; this is the private half and belongs only in the
# environment. Without it updates are served unsigned, which an app built with
# the certificate will refuse — so staging and production both need it, and it
# must be the same key the app was built against.
#
# Stored with literal \n between the lines, the way a deployment environment
# holds a PEM.
# EXPO_OTA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"

# What this process is for. Leave unset for one process that does both.
#   api    — serves requests, arms no scheduler
#   worker — runs the nightly jobs
# Only ever set this when running api and worker as separate deployments.
ROLE=
