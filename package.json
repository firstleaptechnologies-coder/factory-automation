{
  "name": "fas",
  "version": "0.1.0",
  "private": true,
  "description": "Manufacturing ERP for a CNC-based architectural decor unit",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:shared && npm run build --workspace @fas/api && npm run build --workspace @fas/web",
    "dev:api": "npm run dev -w @fas/api --",
    "dev:web": "npm run dev -w @fas/web --",
    "dev:mobile": "npm start --prefix apps/mobile",
    "db:generate": "npm run prisma:generate -w @fas/api --",
    "db:migrate": "npm run prisma:migrate -w @fas/api --",
    "db:migrate:tenants": "npm run migrate:tenants -w @fas/api --",
    "db:seed": "npm run prisma:seed -w @fas/api --",
    "db:studio": "npm run prisma:studio -w @fas/api --",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ios": "npm run ios --prefix apps/mobile",
    "android": "npm run android --prefix apps/mobile",
    "build:shared": "npm run build --workspace @fas/shared --",
    "test": "npm run test --workspaces --if-present",
    "lint:mobile": "npm run lint --prefix apps/mobile",
    "typecheck:mobile": "npm run typecheck --prefix apps/mobile",
    "test:mobile": "npm run test --prefix apps/mobile",
    "ota:publish": "ts-node --transpile-only scripts/publish-ota.ts",
    "verify": "npm run build:shared && npm run db:generate && npm run typecheck --workspaces --if-present && npm test --workspaces --if-present && npm run lint:mobile && npm run typecheck:mobile && npm run test:mobile",
    "docs:manual": "npm run docs:manual -w @fas/api --"
  }
}
