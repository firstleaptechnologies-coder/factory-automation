node_modules/
dist/
build/
.next/
.expo/
coverage/
*.log
.env
.env.local
.DS_Store
apps/api/prisma/*.db
uploads/

# Stray tsc output next to the sources it was built from.
#
# Jest resolves .js ahead of .ts, so one leftover build of a spec helper
# silently shadows the file everyone is editing — the tests then pass or fail
# against code nobody can see.
apps/api/src/**/*.js
apps/api/src/**/*.d.ts
apps/api/src/**/*.js.map
apps/api/test/**/*.js
apps/api/test/**/*.d.ts
apps/api/test/**/*.js.map

# TypeScript's incremental build cache. Machine-local, and noisy in a diff.
*.tsbuildinfo

# The key that signs updates for every phone running this app.
#
# The certificate beside it is public and is committed — the app has to carry
# it to check a signature. The private key is not: it belongs in the API's
# environment and in a password manager, and nowhere else.
apps/mobile/keys/

# Every environment's secrets, and the two names compose interpolates. These
# live only on the box they run on; apps/api/.env.example says what goes in
# them. The directory is ignored wholesale rather than file by file, because
# the day production is stood up is the day a new filename appears here, and a
# per-file rule is one nobody would think to add.
deploy/env/*.env
deploy/.env

# Vercel's link to the project, and the OIDC token it caches beside it. The ids
# are not secret; the token is, and both belong to this machine rather than to
# the repository.
.vercel/
